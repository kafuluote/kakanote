<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/RelativeLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper_canvas">
        <LinearLayout android:id="@+id/PaperHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/paper_canvas">
            <com.google.android.material.appbar.MaterialToolbar android:id="@+id/Toolbar" android:layout_width="match_parent" android:layout_height="64dp" app:contentInsetStart="0dp" app:contentInsetEnd="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/BrandLogo" android:layout_width="28dp" android:layout_height="28dp" android:src="@mipmap/memox" android:contentDescription="@string/app_name" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:id="@+id/BrandName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/product_name" android:textSize="23sp" android:fontFamily="sans-serif-medium" android:textColor="@color/paper_ink" />
                        <TextView android:id="@+id/BrandSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paper_feed" android:textSize="10sp" android:letterSpacing="0.04" android:textColor="@color/paper_muted" />
                    </LinearLayout>
                    <ImageButton android:id="@+id/HeaderSearchButton" android:layout_width="44dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/search" android:tint="@color/paper_ink" android:contentDescription="@string/search" />
                    <ImageButton android:id="@+id/AvatarButton" android:layout_width="44dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:src="@drawable/account_circle" android:tint="@color/paper_accent_ink" android:contentDescription="@string/settings" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
            <com.google.android.material.card.MaterialCardView android:id="@+id/SearchPill" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="8dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/paper_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/search" android:tint="@color/paper_muted" android:importantForAccessibility="no" />
                    <EditText android:id="@+id/SearchEditText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="10dp" android:background="@null" android:hint="@string/paper_search" android:inputType="textFilter" android:imeOptions="actionSearch" android:singleLine="true" android:textSize="14sp" android:textColor="@color/paper_ink" android:textColorHint="@color/paper_muted" android:importantForAutofill="no" />
                    <ImageButton android:id="@+id/FilterButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/sort_arrows" android:background="?attr/selectableItemBackgroundBorderless" android:tint="@color/paper_muted" android:contentDescription="@string/notes_sorted_by" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <FrameLayout android:id="@+id/SyncIsland" android:layout_width="match_parent" android:layout_height="28dp" android:visibility="gone" android:paddingStart="24dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
                    <ProgressBar android:id="@+id/SyncIslandSpinner" style="?android:attr/progressBarStyleSmall" android:layout_width="14dp" android:layout_height="14dp" android:indeterminateTint="@color/paper_accent" android:visibility="gone" android:layout_marginEnd="6dp" />
                    <ImageView android:id="@+id/SyncIslandDone" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/checked_circle" android:tint="@color/paper_accent_ink" android:visibility="gone" android:layout_marginEnd="6dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/SyncIslandText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/paper_accent_ink" android:singleLine="true" android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/ActionMode" android:layout_width="match_parent" android:layout_height="64dp" android:layout_alignParentTop="true" android:background="@color/paper_canvas" app:navigationIcon="@drawable/close" android:visibility="gone" />
        <androidx.fragment.app.FragmentContainerView android:id="@+id/NavHostFragment" android:name="androidx.navigation.fragment.NavHostFragment" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/PaperHeader" app:defaultNavHost="true" app:navGraph="@navigation/navigation" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/BottomNavigation" android:layout_width="match_parent" android:layout_height="72dp" android:layout_alignParentBottom="true" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp" app:cardCornerRadius="36dp" app:cardElevation="6dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/paper_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/NavNotes" style="@style/PaperNavItem" android:text="@string/paper_notes" app:drawableTopCompat="@drawable/notes" />
                <TextView android:id="@+id/NavTodos" style="@style/PaperNavItem" android:text="@string/paper_todos" app:drawableTopCompat="@drawable/checkbox_outline" />
                <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
                <TextView android:id="@+id/NavOrganize" style="@style/PaperNavItem" android:text="@string/paper_organize" app:drawableTopCompat="@drawable/folder" />
                <TextView android:id="@+id/NavExport" style="@style/PaperNavItem" android:text="@string/paper_export" app:drawableTopCompat="@drawable/share" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/TakeNote" style="@style/FloatingActionButtonPrimary" android:layout_width="56dp" android:layout_height="56dp" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:layout_marginBottom="24dp" app:fabCustomSize="56dp" app:maxImageSize="24dp" app:shapeAppearanceOverlay="@style/PaperCircle" app:srcCompat="@drawable/edit" android:contentDescription="@string/take_note" />
    </RelativeLayout>
    <com.google.android.material.navigation.NavigationView android:id="@+id/NavView" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="start" android:fitsSystemWindows="true" app:headerLayout="@layout/nav_header" app:menu="@menu/menu_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
